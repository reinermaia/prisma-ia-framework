# =============================================================
# PRISMA-IA FRAMEWORK — CONFIGURAÇÃO AGNÓSTICA DE PROVEDORES DE LLM
# =============================================================

# Provedor ativo: 'mock' (simulação offline), 'ollama' (on-premise), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=mock

# Configuração Ollama (On-Premise / Local / Zero-Cost)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b
# Alternativas locais recomendadas:
# OLLAMA_MODEL=mistral-nemo:12b
# OLLAMA_MODEL=qwen2.5-coder:32b
# OLLAMA_MODEL=deepseek-r1:14b

# Provedores Comerciais em Nuvem (Opcionais)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Configurações de Threat Intel Feeds
ENABLE_LIVE_CVE_FEED=true
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Auditoria e Assinatura HITL
SECURITY_AUDITOR_NAME=Francis Martins
SECURITY_AUDITOR_ROLE=Lead Security Architect
